# ── Google Tag / Ads / GA4 — centrale trackinglaag (lib/tracking) ──
# Geconsolideerde Google Tag (loader met AW + GA4 als bestemmingen)
NEXT_PUBLIC_GOOGLE_TAG_ID=GT-XXXXXXX
# Google Ads conversion-account
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXXX
# GA4 measurement-id (leeg = GA4 uit)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# Conversielabels: het deel ná de slash in AW-xxx/LABEL
# (Google Ads > Doelen > Conversies > actie > Tag-instellingen). Leeg = niet meten.
NEXT_PUBLIC_GOOGLE_ADS_TRIAL_SIGNUP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_DEMO_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# Rapportagewaarden (EUR); afstemmen op de waarde-instelling van de Ads-actie
NEXT_PUBLIC_GOOGLE_ADS_TRIAL_SIGNUP_VALUE=359.40
NEXT_PUBLIC_GOOGLE_ADS_LEAD_VALUE=15
NEXT_PUBLIC_GOOGLE_ADS_DEMO_VALUE=50
# Domein voor consent-/attributiecookies (gedeeld met app.snellio.nl)
NEXT_PUBLIC_TRACKING_COOKIE_DOMAIN=snellio.nl
# Google Tag Manager: ALLEEN als GoogleTag.tsx uit staat (anders dubbele gtag)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Microsoft ─────────────────────────────────────
NEXT_PUBLIC_CLARITY_ID=abcdefghij
# NEXT_PUBLIC_BING_UET_TAG=XXXXXXXX

# ── Meta ──────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456

# ── Site URL (voor canonical/sitemap) ─────────────
NEXT_PUBLIC_SITE_URL=https://snellio.nl
